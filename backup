#!/bin/bash

TITLE=$(cat << DELIMITER
Backup - Gut's Utils
- A wrapper around Rsync.
DELIMITER
)

HELP=$(cat << DELIMITER
USAGE:
$ backup [SOURCE_DRIVE_LABEL]

INFO:
This is a driver backup ultility, refer to a drive through it's label.
Source location is: /run/media/$USER/[SOURCE_DRIVE_LABEL]

The backup is stored under /home/$USER/Backups/

OPTIONS:
 -p --full-path -specify the full path of the source device (Useful if this command is executed from another e.g. automation)

# Ideas for the future
Let the user define it's default backuped drives, to backup all them when the user executes this command

$ backup -m --mount, mount the device before starting the backup (if found)
$ backup -u --unmount, unmount the drive after the backup is done
DELIMITER
)

echo_modified_files(){
	CHANGED_FILES=$(rsync --dry-run -avz /run/media/gut/Paulo_3i3 /home/gut/Backups/ | grep Paulo_3i3)
	printf "Here's What Changed:\n $CHANGED_FILES"
}

MEDIA_PATH="/run/media/$USER"
BACKUP_PATH="$HOME/Backups/"

make_backup(){
 # $1 - Source folder.
 echo_modified_files
 notify-send "Starting Backup."
 rsync -avz --progress --delete $1 "$BACKUP_PATH"
 notify-send "Finished Backup of ${1}"
}

# $1 - Drive to backup from
if [ -z "$1" ]; then
# If empty
	make_backup "$MEDIA_PATH/Paulo_3i3"
	exit

elif [ "$1" = "-p" -o "$1" = "--full-path" ]; then
	# $1 -> Option
    # $2 -> Drive Path
	# USEFUL for backup automation.
	make_backup $2
	sleep 1
	exit

elif [ "$1" = "-h" ]; then
	echo -e $TITLE $HELP
	exit
fi

notify-send "Initializing backup Application."
make_backup "$MEDIA_PATH/$1"
