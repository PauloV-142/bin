#!/bin/bash

###############
## Variables ##
###############

HELP=$(cat << DELIMITER
Backup - Gut's Utils
- A wrapper around Rsync.

USAGE:
$ backup [SOURCE_DRIVE_LABEL]

INFO:
This is a driver backup ultility, refer to a drive through it's label.
Source location is: /run/media/$USER/[SOURCE_DRIVE_LABEL]

The backup is stored under /home/$USER/Backups/

OPTIONS:
 -p --full-path -specify the full path of the source device (Useful if this command is executed from another e.g. automation)

# Ideas for the future
Let the user define it's default backuped drives, to backup all them when the user executes this command

$ backup -m --mount, mount the device before starting the backup (if found)
$ backup -u --unmount, unmount the drive after the backup is done
DELIMITER
)

MEDIA_PATH="/run/media/$USER"
BACKUP_PATH="$HOME/Backups/"

###############
## Functions ##
###############

ask_for_permission() {
 # $1 - Source Drive/Folder path.
 ANSWER=$(
   notify-send --wait -t 100000 --action="No" --action="Yes" --app-name="Backup" "Start backup now?"
  )

  case $ANSWER in
	0)
	 notify-send --app-name="Backup" "Cancelled."
	 exit;;

	1)
	 #notify-send --app-name="Backup" "Starting soon."
	 ;;
  esac
}

 notification="notify-send --app-name=Backup"

make_backup(){
 # $1 - Source Drive/Folder path.

 print_modified_files

 $notification "Starting Backup."

 rsync --dry-run -avz --progress --delete $1 "$BACKUP_PATH"

 $notification "Finished Backup."
}

print_modified_files(){
	CHANGED_FILES=$(
	 rsync --dry-run -avz $1 /home/gut/Backups/
	)

	notify-send "Here's What Changed: $CHANGED_FILES"
}

count_modified_files(){
 # $1 - Source Folder
 NUMBER_OF_MODIFIED_FILES=$(
  rsync --dry-run -avz $1 /home/gut/Backups/ | grep -c $1
 )

 notify-send --app-name="Backup" "Files modified: $($NUMBER_OF_MODIFIED_FILES)"

}

####################
## Handle Options ##
####################

while getopts "hp: a" option; do
	case $option in
		h) # --help
			echo -e $HELP
			exit;;
		p) # --full-path
			USE_FULL_PATH=1
			FULL_PATH=$OPTARG
			;;
		a) # --ask-for-permission
			ASK_FOR_PERMISSION=1
			;;
	esac
done

##########
## Main ##
##########

if [ $ASK_FOR_PERMISSION ]; then
 ask_for_permission
fi


if [ ! $USE_FULL_PATH ]; then

 # Get non-option arguments:
 shift $((OPTIND - 1))

 if [ $1 ]; then
  FULL_PATH="/run/media/$USER/$1"
 else
  # Fallback - Default folder to backup
  FULL_PATH="/run/media/$USER/Paulo_3i3"
 fi
fi


echo $1 one
echo $FULL_PATH fh
echo $@ OPTIND
make_backup $FULL_PATH

